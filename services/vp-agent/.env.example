SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...      # Project Settings → API → anon/public key
SUPABASE_SERVICE_KEY=eyJ...   # Project Settings → API → service_role key
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# xAI (Grok) — chat/reasoning LLM. Get a key at https://console.x.ai
XAI_API_KEY=xai-...
XAI_API_BASE=https://api.x.ai/v1   # override for a proxy/regional endpoint

# OpenAI — embeddings only (xAI has no embeddings endpoint)
OPENAI_API_KEY=sk-...

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=

# BackBlazeTranscription service (server-to-server B2-link ingestion)
TRANSCRIPTION_API_URL=https://backblazetranscription.onrender.com
TRANSCRIPTION_API_KEY=

# Private n8n workflow used to trash Drive transcript/summary exports.
MEDIA_DELETION_WEBHOOK_URL=
MEDIA_DELETION_WEBHOOK_SECRET=

# OpusClip (Enterprise or Pro plan required — https://clip.opus.pro/dashboard)
OPUSCLIP_API_KEY=
OPUSCLIP_API_URL=https://api.opus.pro/api

# Optional — LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...

# Tuning
MAX_CRITIQUE_ITERATIONS=3
EMBEDDING_MODEL=text-embedding-3-small   # OpenAI embedding model (must match the DB's vectors)
LLM_MODEL=grok-4                         # xAI Grok chat model ID
LOG_LEVEL=INFO
REQUIRE_BRAND_DOCTRINE=true
CONTEXT_WINDOW_MESSAGES=12   # max messages sent to LLM per turn (full history still saved)
RETRIEVE_MATCH_COUNT=15      # top-K transcript chunks from hybrid search (relevance-ranked)
CORS_ORIGINS=*               # comma-separated allowed origins; set to frontend URL(s) in prod
