# API Configuration
API_KEY=your-secret-api-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Server-side credentials used to store local uploads in B2.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ARCHIVE_BUCKET=
B2_VIDEO_PREFIX=videos
B2_THUMBNAIL_PREFIX=thumbnails
THUMBNAIL_AT_SECONDS=3

# Worker Configuration (use 1 on free/low-memory tiers e.g. Render free 512MB)
MAX_CONCURRENT_JOBS=1
CONCURRENT_CHUNKS=1  # Chunks transcribed at a time per job (1 = minimal disk/RAM)
CHUNK_DURATION_SECONDS=600  # Length of each chunk in seconds; increase (e.g. 900) for fewer files

# Timeouts (seconds). Important: b2sdk uses synchronous urllib3 with no aggressive read
# timeout, so a silently-dropped TCP socket can hang for ~2h until the OS notices.
# These limits ensure the queue can recover from hung B2 calls instead of stalling.
JOB_TIMEOUT_SECONDS=10800   # Master per-job timeout (3h). On exceed, job is failed and queue moves on.
B2_STREAM_TIMEOUT=7200      # B2 download timeout (2h). Covers full file transfer.
B2_UPLOAD_TIMEOUT=300       # B2 transcript upload timeout (5m). Transcripts are tiny.

# Disk safety: pre-flight check before downloading a file. Job is failed (not started)
# if size * DISK_OVERHEAD_FACTOR + DISK_SAFETY_MARGIN_BYTES > free disk on TEMP_STORAGE_DIR.
DISK_SAFETY_MARGIN_BYTES=536870912   # 512 MB headroom for chunks/transcript/etc.
DISK_OVERHEAD_FACTOR=1.20            # Source file + extracted audio + active chunk ≈ 1.2× source

# CORS — allowed origins for browser frontend (comma-separated, or * for all)
# e.g. CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=*

# Temp Storage (Render persistent SSD mount)
# Worker writes all in-flight job files to {TEMP_STORAGE_DIR}/transcription_work
# and clears that subdir on boot. Falls back to system temp if the path doesn't exist.
TEMP_STORAGE_DIR=/data
#TEST
# Testing (optional)
BASE_URL=http://localhost:8000
